# Local demo works without any credentials.
DEMO_MODE=true

# Optional: risk threshold for candidate-memory screening (0..1).
SCREENING_THRESHOLD=0.45

# Structured JSON logging level (debug | info | warn | error).
LOG_LEVEL=info

# CockroachDB Cloud (required when DEMO_MODE=false)
DATABASE_URL=

# Connection pool tuning (defaults shown)
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
# auto = honor sslmode from DATABASE_URL; true = force ssl; false = disable
DB_SSL=auto
# PEM root certificate for private CAs. Use \\n for line breaks.
DB_CA_CERT=

# Live API boundary. Generate a key and SHA-256 hash with `npm run auth:key`.
# Each deployment serves one tenant and one tenant-specific DATABASE_URL.
ANTIDOTE_TENANT_ID=
ANTIDOTE_API_KEYS=[]
API_RATE_LIMIT_PER_MINUTE=600

# AWS Bedrock, optional when OpenCode Go is configured
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=1024
EVIDENCE_BUCKET=
# Tenant HMAC key for source and repair evidence. Store this in a secret manager.
EVIDENCE_SIGNING_SECRET=

# Optional: managed CockroachDB MCP endpoint metadata for the Security/
# Forensics agent runtime (server-side only, never bundled to the browser).
# Create the MCP server bound to the read-only `antidote_forensics` role
# (see db/roles.sql), then set these from the issued values.
COCKROACH_MCP_URL=
COCKROACH_MCP_API_KEY=

# OpenCode Go reasoning provider. Required in live mode when Bedrock is absent.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Required to rerun custom agents after repair. The callback receives signed,
# clean evidence and returns either a replacement decision or a refusal.
REEVALUATION_CALLBACK_URL=
REEVALUATION_CALLBACK_SECRET=

# Optional: set to "false" to switch the system of record from the in-memory
# demo store to CockroachDB (requires DATABASE_URL + applied migrations).
# DEMO_MODE=false
